NODE_ENV=development
PORT=8080
LOG_LEVEL=debug

# Supabase del propio AI service (resumenes, conversaciones, api_clients).
# SUPABASE_SECRET_KEY es la API key moderna (formato sb_secret_xxx) que
# reemplaza a la legacy service_role JWT. Bypasa RLS, NUNCA exponer en navegador.
# Si tu proyecto Supabase aun no migra a las nuevas claves, puedes seguir
# definiendo SUPABASE_SERVICE_ROLE_KEY (legacy) y el servicio lo tomara como fallback.
SUPABASE_URL=https://your-ai-project.supabase.co
SUPABASE_SECRET_KEY=sb_secret_replace_with_real_key
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...  # legacy fallback

# Proveedores LLM
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=http://localhost:5173
OPENROUTER_SITE_NAME=EMR Dev

# Pool de modelos para preferencia "auto". Se intentan en el ORDEN listado:
# el primero es la primera opcion; si falla con 404/429/5xx o devuelve contenido
# vacio (caso tipico de modelos "thinking" que gastan tokens razonando sin
# producir salida visible), se rota al siguiente. Recomendado:
#   1) openrouter/free  -> auto-router oficial; selecciona un :free compatible
#   2-N) modelos :free especificos como red de seguridad si openrouter/free falla
# Listar :free disponibles:   pnpm openrouter:list
# Probar cuales responden:    pnpm openrouter:probe
OPENROUTER_AUTO_MODELS=openrouter/free,openai/gpt-oss-120b:free,qwen/qwen3-next-80b-a3b-instruct:free,openai/gpt-oss-20b:free

# Versiones de los prompts (cambia el sufijo para invalidar cache)
PROMPT_VERSION_MEDICAL_RECORD=medical-record-v1
PROMPT_VERSION_EVOLUTION=evolution-v1
PROMPT_VERSION_CHAT=chat-system-v1

# Limites
RATE_LIMIT_PER_MINUTE=30
MAX_CHAT_HISTORY_MESSAGES=20

# CORS: lista de origenes permitidos separados por coma. Usar * solo en pruebas.
# Para Vite local el default ya cubre http://localhost:5173 y http://127.0.0.1:5173.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
