{
  "name": "emr-ai-service",
  "version": "0.1.0",
  "description": "AI service for EMR systems: clinical summaries and follow-up chats backed by DeepSeek and OpenRouter.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "tsx watch src/presentation/http/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/presentation/http/server.js",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.4",
    "argon2": "^0.41.1",
    "dotenv-flow": "^4.1.0",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "jose": "^5.9.3",
    "openai": "^4.67.3",
    "pino": "^9.5.0",
    "pino-pretty": "^11.2.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.7.5",
    "@types/supertest": "^6.0.2",
    "oxlint": "^0.10.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.2"
  },
  "packageManager": "pnpm@9.12.1"
}
